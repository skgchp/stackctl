# stackctl configuration (mode 0600). The file is sourced by bash, so values must not contain
#   "  $  `  or a backslash.
#
# Where it lives:
#   rootless Docker (run as the Docker user): ~/.config/stackctl/stackctl.conf
#   rootful Docker (run as root):             /etc/stackctl/stackctl.conf
# Override the location with STACKCTL_CONFIG=/path/to/file. install.sh writes this file for you.
#
# This file is the config contract: renaming or removing a key is a breaking change (see AGENTS.md).

# ---- Docker -----------------------------------------------------------------
# auto: rootful when run as root, rootless otherwise. Set it to make a wrong user fail loudly.
DOCKER_MODE="auto"

# ---- Required ---------------------------------------------------------------
# Folder holding one sub-folder per stack (each with a compose.yaml).
STACKS_DIR="/home/dockeruser/stacks"

# Git repo with the stacks, fetched read-only. Works with GitHub, GitLab, Forgejo, Gitea and any
# other Git server. Over SSH (a non-standard port goes in the URL):
#   git@github.com:YOUR-USER/YOUR-STACKS-REPO.git
#   ssh://git@forgejo.example.com:2222/YOUR-USER/YOUR-STACKS-REPO.git
# Over HTTPS, with GIT_TOKEN_FILE below:
#   https://gitlab.example.com/YOUR-USER/YOUR-STACKS-REPO.git
GIT_REMOTE="git@github.com:YOUR-USER/YOUR-STACKS-REPO.git"
BRANCH="main"

# ---- Git authentication (optional) ------------------------------------------
# SSH: a read-only deploy key. (GITHUB_SSH_KEY, the old name, still works.)
GIT_SSH_KEY="/home/dockeruser/.ssh/git-deploy"
# SSH: a known_hosts file to trust instead of ~/.ssh/known_hosts. Host keys are always verified.
GIT_KNOWN_HOSTS=""
# HTTPS: a file (mode 0600) holding a read-only access token. Used with an https:// GIT_REMOTE.
# GIT_USERNAME is "oauth2" for GitLab access tokens and Forgejo/Gitea tokens; a GitLab deploy token
# has its own username (gitlab+deploy-token-N).
GIT_TOKEN_FILE=""
GIT_USERNAME="oauth2"

# ---- Backups: set BORG_REPO (Borg) or BACKUP_DIR (tar files) ----------------
# auto: Borg if BORG_REPO is set, otherwise tar files in BACKUP_DIR. One of the two is required.
BACKUP_BACKEND="auto"

# Tar backend: one compressed tar file per backup, in BACKUP_DIR/<stack>/. Not encrypted, so
# keep the folder somewhere private, and copy it off the server (a separate disk, NAS, rsync).
BACKUP_DIR=""
TAR_COMPRESSION="zstd"      # zstd (falls back to gzip when zstd is not installed) or gzip

# Borg backend. For a Hetzner Storage Box sub-account the :23 and the /./ are both required:
#   ssh://u123456-sub1@u123456.your-storagebox.de:23/./backups/myhost
BORG_REPO=""
# Command that prints the repo passphrase. Keep that file mode 0600.
BORG_PASSCOMMAND="cat /home/dockeruser/.config/stackctl/borg-passphrase"
# Borg over SSH. In rootless Docker, Borg runs inside Docker's user namespace, where root-owned
# files (/etc/ssh) appear as "nobody" and ssh looks for known_hosts under /root. So: own -F config
# file, explicit known_hosts. In rootful mode a plain "ssh -i KEY" is enough.
#BORG_RSH="ssh -F /home/dockeruser/.config/stackctl/ssh_config -i /home/dockeruser/.ssh/storagebox -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile=/home/dockeruser/.ssh/known_hosts"
# Remote borg binary, e.g. "borg-1.4" on a Storage Box.
BORG_REMOTE_PATH=""

# ---- Retention (nightly and pre-update archives, per stack) -----------------
KEEP_DAILY=3
KEEP_WEEKLY=3
KEEP_MONTHLY=3
KEEP_PRE=3

# ---- Folders outside the stacks, backed up by "stackctl data" ---------------
# Space-separated absolute paths. Each becomes its own archive series.
DATA_DIRS=""
KEEP_DATA_DAILY=7
KEEP_DATA_WEEKLY=4
KEEP_DATA_MONTHLY=3

# ---- Notifications (ntfy, optional) -----------------------------------------
# Leave NTFY_URL empty to turn notifications off. Include the topic: https://ntfy.example.com/my-topic
NTFY_URL=""
NTFY_TOKEN=""
NOTIFY_SUCCESS=true
NOTIFY_NIGHTLY_SUCCESS=false
